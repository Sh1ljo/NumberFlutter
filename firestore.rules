rules_version = '2';

// Security rules for NumberFlutter. Deploy with:
//   firebase deploy --only firestore:rules,firestore:indexes
//
// The app still reports its own scores; server-side validation needs Cloud
// Functions (Blaze plan).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function optionalString(data, field, maxLength) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maxLength);
    }

    // Public profile: names and locations appear on the leaderboard.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && optionalString(request.resource.data, 'display_name', 100)
        && optionalString(request.resource.data, 'country', 100)
        && optionalString(request.resource.data, 'city', 100);
      allow delete: if false;

      // Archived prestige runs: private and append-only.
      match /sessions/{sessionId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    // Full cloud save: only its owner can see it.
    match /player_progress/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.user_id == uid;
      allow delete: if false;
    }

    // Public ranking rows, one per player.
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && optionalString(request.resource.data, 'display_name', 100)
        && optionalString(request.resource.data, 'country', 100)
        && optionalString(request.resource.data, 'city', 100)
        && optionalString(request.resource.data, 'highest_number_numeric', 100000)
        && (!('highest_number_log10' in request.resource.data)
            || request.resource.data.highest_number_log10 is number)
        && (!('neural_lowest_loss' in request.resource.data)
            || request.resource.data.neural_lowest_loss is number);
      allow delete: if false;
    }

    // ── Weekly / Monthly Trial boards ──────────────────────────────────
    // One bucket per week ("2026-09-21", the Monday) and per month
    // ("2026-09"). A bucket only accepts writes while its period is open
    // (plus a day of grace for a final sync), and a score can only go up.
    // Scores are still client-reported; the caps just stop absurd values.

    function publicFieldsOk(data) {
      return optionalString(data, 'display_name', 100)
        && optionalString(data, 'country', 100)
        && optionalString(data, 'city', 100);
    }

    function trialWeekStart(weekId) {
      let p = weekId.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }

    function trialMonthStart(monthId) {
      let p = monthId.split('-');
      return timestamp.date(int(p[0]), int(p[1]), 1);
    }

    function neverDecreases() {
      return resource == null
        || request.resource.data.score >= resource.data.score;
    }

    match /trial_weeks/{weekId}/entries/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && weekId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time >= trialWeekStart(weekId)
        && request.time < trialWeekStart(weekId) + duration.value(8, 'd')
        && request.resource.data.keys().hasOnly([
             'display_name', 'country', 'city',
             'score', 'total', 'points', 'tier', 'updated_at'])
        && publicFieldsOk(request.resource.data)
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 30
        && request.resource.data.points is int
        && request.resource.data.points <= 3000
        && neverDecreases();
      allow delete: if false;
    }

    match /trial_months/{monthId}/entries/{uid} {
      allow read: if signedIn();
      // A month's first week can start up to 3 days before the 1st, and
      // its last week can end up to 4 days after the month does.
      allow create, update: if isOwner(uid)
        && monthId.matches('^[0-9]{4}-[0-9]{2}$')
        && request.time >= trialMonthStart(monthId) - duration.value(4, 'd')
        && request.time < trialMonthStart(monthId) + duration.value(39, 'd')
        && request.resource.data.keys().hasOnly([
             'display_name', 'country', 'city', 'score', 'weeks', 'updated_at'])
        && publicFieldsOk(request.resource.data)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 15000
        && request.resource.data.weeks is map
        && request.resource.data.weeks.size() <= 5
        && neverDecreases();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
